---
import headerLogo from '../assets/phoenicia-header-logo.png';

interface Props {
  active?: 'home' | 'about' | 'menu' | 'cooking-classes' | 'catering' | 'contact';
}
const { active } = Astro.props as Props;
---

<header class="site-header">
  <div class="nav-row">
    <a class="logo" href="/home" aria-label="Phoenicia Mediterranean Deli — home">
      <img
        src={headerLogo.src}
        width={headerLogo.width}
        height={headerLogo.height}
        alt="Phoenicia Mediterranean Deli logo"
        class="logo-mark"
      />
    </a>
    <nav class="primary" id="primaryNav">
      <a href="/home" class={active === 'home' ? 'active' : ''}>Home</a>
      <a href="/about" class={active === 'about' ? 'active' : ''}>About</a>
      <a href="/menu" class={active === 'menu' ? 'active' : ''}>Menu</a>
      <a href="/cooking-classes" class={active === 'cooking-classes' ? 'active' : ''}>Cooking Classes</a>
      <div class="nav-item">
        <button
          type="button"
          class={'dropdown-toggle' + (active === 'catering' ? ' active' : '')}
          aria-expanded="false"
          aria-haspopup="true"
        >
          Catering
          <svg class="chevron" viewBox="0 0 24 24" width="12" height="12">
            <path d="M6 8l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="dropdown-menu">
          <a href="/catering/full-menu">Catering Full Menu</a>
          <a href="/catering/overview">Overview &amp; Event Planning</a>
          <a href="/catering/full-menu#bulk-trays">Bulk Trays &amp; Appetizers</a>
          <a href="/catering/full-menu#meeting-boxes">Meeting Gourmet Boxes</a>
          <a href="/catering/full-menu#ready-to-eat-meals">Ready-to-Eat Meals</a>
        </div>
      </div>
      <a href="/contact" class={active === 'contact' ? 'active' : ''}>Contact</a>
      <a href="https://phoenicia-mediterranean.com/" target="_blank" rel="noopener">Online Store</a>
    </nav>
    <div class="header-actions">
      <a href="tel:3147649222" class="phone-link">
        <svg viewBox="0 0 24 24"><use href="#icon-phone" /></svg>
        (314) 764-9222
      </a>
      <button type="button" class="header-order-btn" data-order-placeholder>Order Now</button>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" id="navToggleIcon"><use href="#icon-menu" /></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--olive);
    border-bottom: 1px solid var(--line-on-dark);
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 28px;
    gap: 20px;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-mark {
    height: 64px;
    width: auto;
    flex: none;
    object-fit: contain;
  }

  nav.primary {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  nav.primary a {
    font-size: 1.18rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--sand);
    position: relative;
    padding: 4px 0;
  }

  nav.primary a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--sand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  nav.primary a:hover::after,
  nav.primary a.active::after {
    transform: scaleX(1);
  }

  nav.primary a.active {
    color: var(--sand);
  }

  .nav-item {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    padding-bottom: 14px;
    margin-bottom: -14px;
  }

  .dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    padding: 4px 0;
    cursor: pointer;
    position: relative;
    color: var(--sand);
    font-family: inherit;
    font-size: 1.18rem;
    font-weight: 700;
  }

  .dropdown-toggle::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--sand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .dropdown-toggle:hover::after,
  .dropdown-toggle.active::after,
  .nav-item.open .dropdown-toggle::after {
    transform: scaleX(1);
  }

  .chevron {
    transition: transform 0.2s ease;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 180px;
    background: var(--olive);
    border: 1px solid var(--line-on-dark);
    border-radius: 10px;
    padding: 8px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 110;
  }

  .dropdown-menu a {
    display: block;
    font-size: 0.98rem;
    font-weight: 600;
    padding: 9px 14px;
    border-radius: 6px;
    white-space: nowrap;
    color: var(--sand);
    text-decoration: none;
  }

  .dropdown-menu a::after {
    display: none;
  }

  .dropdown-menu a:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-item:hover .dropdown-menu,
    .nav-item:focus-within .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .nav-item:hover .chevron,
    .nav-item:focus-within .chevron {
      transform: rotate(180deg);
    }
  }

  .nav-item.open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-item.open .chevron {
    transform: rotate(180deg);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .phone-link {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    color: var(--sand);
  }

  .phone-link svg {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--sand);
  }

  .header-order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: #fbeee9;
    background: linear-gradient(180deg, #9e1b1e 0%, #6b0c0f 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 11px 26px;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgba(60, 10, 10, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .header-order-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(60, 10, 10, 0.36);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--sand);
  }

  .nav-toggle svg {
    width: 26px;
    height: 26px;
  }

  @media (max-width: 1140px) {
    nav.primary {
      position: fixed;
      top: 80px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--olive);
      flex-direction: column;
      align-items: flex-start;
      padding: 28px;
      gap: 24px;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      z-index: 99;
    }
    nav.primary.open {
      transform: translateX(0);
    }
    nav.primary a,
    .dropdown-toggle {
      font-size: 1.25rem;
    }
    .nav-toggle {
      display: block;
    }
    .nav-item {
      flex-wrap: wrap;
      width: 100%;
      padding-bottom: 0;
      margin-bottom: 0;
    }
    .dropdown-menu {
      position: static;
      flex-basis: 100%;
      width: 100%;
      max-height: 0;
      opacity: 1;
      visibility: visible;
      transform: none;
      overflow: hidden;
      padding: 0;
      margin-top: 0;
      border: none;
      box-shadow: none;
      background: transparent;
      transition: max-height 0.25s ease;
    }
    .nav-item.open .dropdown-menu {
      max-height: 160px;
      padding: 6px 0 0 4px;
    }
    .dropdown-menu a {
      font-size: 1.05rem;
      padding: 8px 0;
      color: rgba(247, 238, 221, 0.85);
    }
  }

  @media (max-width: 600px) {
    .nav-row {
      padding: 8px 18px;
      gap: 10px;
    }
    .header-actions {
      gap: 10px;
    }
    .phone-link {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .header-order-btn {
      padding: 9px 18px;
      font-size: 0.76rem;
    }
  }
</style>

<script>
  const navToggle = document.getElementById('navToggle');
  const primaryNav = document.getElementById('primaryNav');
  const navToggleIcon = document.getElementById('navToggleIcon');
  const dropdownItems = Array.from(document.querySelectorAll('.nav-item'));

  const closeDropdown = (item) => {
    item.classList.remove('open');
    item.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
  };

  const closeAllDropdowns = () => {
    dropdownItems.forEach(closeDropdown);
  };

  navToggle?.addEventListener('click', () => {
    const isOpen = primaryNav?.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', String(!!isOpen));
    if (navToggleIcon) {
      navToggleIcon.innerHTML = isOpen
        ? '<use href="#icon-close"/>'
        : '<use href="#icon-menu"/>';
    }
    closeAllDropdowns();
  });

  primaryNav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      primaryNav.classList.remove('open');
      navToggle?.setAttribute('aria-expanded', 'false');
      if (navToggleIcon) navToggleIcon.innerHTML = '<use href="#icon-menu"/>';
      closeAllDropdowns();
    });
  });

  dropdownItems.forEach((item) => {
    const toggle = item.querySelector('.dropdown-toggle');
    toggle?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isOpen = item.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(!!isOpen));
      dropdownItems.forEach((other) => {
        if (other !== item) closeDropdown(other);
      });
    });
  });

  document.addEventListener('click', (e) => {
    dropdownItems.forEach((item) => {
      if (!item.contains(e.target)) closeDropdown(item);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });
</script>
