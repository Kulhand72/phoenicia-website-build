---
import headerLogo from '../assets/phoenicia-header-logo.png';
import { withBase } from '../lib/base';

interface Props {
  active?: 'home' | 'about' | 'menu' | 'cooking-classes' | 'catering' | 'contact';
}
const { active } = Astro.props as Props;
---

<header class="site-header">
  <div class="nav-row">
    <a class="logo" href={withBase('/home')} aria-label="Phoenicia Mediterranean Deli — home">
      <img
        src={headerLogo.src}
        width={headerLogo.width}
        height={headerLogo.height}
        alt="Phoenicia Mediterranean Deli logo"
        class="logo-mark"
      />
    </a>
    <nav class="primary" id="primaryNav">
      <a href={withBase('/home')} class={active === 'home' ? 'active' : ''}>Home</a>
      <a href={withBase('/about')} class={active === 'about' ? 'active' : ''}>About</a>
      <a href={withBase('/menu')} class={active === 'menu' ? 'active' : ''}>Menu</a>
      <a href={withBase('/cooking-classes')} class={active === 'cooking-classes' ? 'active' : ''}>Cooking Classes</a>
      <div class="nav-item">
        <button
          type="button"
          class={'dropdown-toggle' + (active === 'catering' ? ' active' : '')}
          aria-expanded="false"
          aria-haspopup="true"
        >
          Catering
          <svg class="chevron" viewBox="0 0 24 24" width="12" height="12">
            <path d="M6 8l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="dropdown-menu">
          <a href={withBase('/catering/full-menu')}>Catering Full Menu</a>
          <a href={withBase('/catering/overview')}>Overview &amp; Event Planning</a>
          <a href={withBase('/catering/full-menu#bulk-trays')}>Bulk Trays &amp; Appetizers</a>
          <a href={withBase('/catering/full-menu#meeting-boxes')}>Meeting Gourmet Boxes</a>
          <a href={withBase('/catering/full-menu#ready-to-eat-meals')}>Ready-to-Eat Meals</a>
        </div>
      </div>
      <a href={withBase('/contact')} class={active === 'contact' ? 'active' : ''}>Contact</a>
      <a href="https://phoenicia-mediterranean.com/" target="_blank" rel="noopener">Online Store</a>
    </nav>
    <div class="header-actions">
      <a href="tel:3147649222" class="phone-link">
        <svg viewBox="0 0 24 24"><use href="#icon-phone" /></svg>
        (314) 764-9222
      </a>
      <div class="cart-item">
        <button
          type="button"
          class="cart-toggle"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label="View cart"
        >
          <svg viewBox="0 0 24 24"><use href="#icon-cart" /></svg>
          <span class="cart-badge" id="cartBadge" hidden>0</span>
        </button>
        <div class="cart-dropdown">
          <p class="cart-empty" id="cartEmpty">Your cart is empty.</p>
          <div class="cart-lines" id="cartLines"></div>
          <div class="cart-footer" id="cartFooter" hidden>
            <div class="cart-total">Estimated total: <span id="cartTotal">$0.00</span></div>
            <button type="button" class="cart-checkout-btn" data-order-placeholder>Checkout</button>
          </div>
        </div>
      </div>
      <button type="button" class="header-order-btn" data-order-placeholder>Order Now</button>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" id="navToggleIcon"><use href="#icon-menu" /></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--olive);
    border-bottom: 1px solid var(--line-on-dark);
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 28px;
    gap: 20px;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-mark {
    height: 64px;
    width: auto;
    flex: none;
    object-fit: contain;
  }

  nav.primary {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  nav.primary a {
    font-size: 1.18rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--sand);
    position: relative;
    padding: 4px 0;
  }

  nav.primary a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--sand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  nav.primary a:hover::after,
  nav.primary a.active::after {
    transform: scaleX(1);
  }

  nav.primary a.active {
    color: var(--sand);
  }

  .nav-item {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    padding-bottom: 14px;
    margin-bottom: -14px;
  }

  .dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    padding: 4px 0;
    cursor: pointer;
    position: relative;
    color: var(--sand);
    font-family: inherit;
    font-size: 1.18rem;
    font-weight: 700;
  }

  .dropdown-toggle::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--sand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .dropdown-toggle:hover::after,
  .dropdown-toggle.active::after,
  .nav-item.open .dropdown-toggle::after {
    transform: scaleX(1);
  }

  .chevron {
    transition: transform 0.2s ease;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 180px;
    background: var(--olive);
    border: 1px solid var(--line-on-dark);
    border-radius: 10px;
    padding: 8px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 110;
  }

  .dropdown-menu a {
    display: block;
    font-size: 0.98rem;
    font-weight: 600;
    padding: 9px 14px;
    border-radius: 6px;
    white-space: nowrap;
    color: var(--sand);
    text-decoration: none;
  }

  .dropdown-menu a::after {
    display: none;
  }

  .dropdown-menu a:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-item:hover .dropdown-menu,
    .nav-item:focus-within .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .nav-item:hover .chevron,
    .nav-item:focus-within .chevron {
      transform: rotate(180deg);
    }
  }

  .nav-item.open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-item.open .chevron {
    transform: rotate(180deg);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .phone-link {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    color: var(--sand);
  }

  .phone-link svg {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--sand);
  }

  .header-order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: #fbeee9;
    background: linear-gradient(180deg, #9e1b1e 0%, #6b0c0f 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 11px 26px;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgba(60, 10, 10, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .header-order-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(60, 10, 10, 0.36);
  }

  .cart-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .cart-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--line-on-dark);
    background: rgba(255, 255, 255, 0.06);
    color: var(--sand);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .cart-toggle:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: translateY(-1px);
  }

  .cart-toggle svg {
    width: 20px;
    height: 20px;
  }

  .cart-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 999px;
    background: #9e1b1e;
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
  }

  .cart-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 300px;
    max-width: calc(100vw - 40px);
    background: var(--paper);
    color: var(--ink);
    border-radius: 10px;
    border: 1px solid var(--line);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.28);
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 120;
  }

  .cart-item.open .cart-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .cart-empty {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--ink-soft);
    margin: 0;
    text-align: center;
    padding: 8px 0;
  }

  .cart-lines {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 300px;
    overflow-y: auto;
  }

  .cart-line {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .cart-line:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cart-line-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cart-line-name {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
  }

  .cart-line-price {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .cart-line-controls {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: none;
  }

  .cart-qty-btn {
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  .cart-qty-btn:hover {
    background: var(--sand);
  }

  .cart-qty {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    min-width: 14px;
    text-align: center;
  }

  .cart-line-remove {
    background: none;
    border: none;
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0 0 4px;
  }

  .cart-line-remove:hover {
    color: #9e1b1e;
  }

  .cart-footer {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cart-total {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink);
  }

  .cart-checkout-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: #fbeee9;
    background: linear-gradient(180deg, #9e1b1e 0%, #6b0c0f 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 11px 20px;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .cart-checkout-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(60, 10, 10, 0.36);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--sand);
  }

  .nav-toggle svg {
    width: 26px;
    height: 26px;
  }

  @media (max-width: 1140px) {
    nav.primary {
      position: fixed;
      top: 80px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--olive);
      flex-direction: column;
      align-items: flex-start;
      padding: 28px;
      gap: 24px;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      z-index: 99;
    }
    nav.primary.open {
      transform: translateX(0);
    }
    nav.primary a,
    .dropdown-toggle {
      font-size: 1.25rem;
    }
    .nav-toggle {
      display: block;
    }
    .nav-item {
      flex-wrap: wrap;
      width: 100%;
      padding-bottom: 0;
      margin-bottom: 0;
    }
    .dropdown-menu {
      position: static;
      flex-basis: 100%;
      width: 100%;
      max-height: 0;
      opacity: 1;
      visibility: visible;
      transform: none;
      overflow: hidden;
      padding: 0;
      margin-top: 0;
      border: none;
      box-shadow: none;
      background: transparent;
      transition: max-height 0.25s ease;
    }
    .nav-item.open .dropdown-menu {
      max-height: 160px;
      padding: 6px 0 0 4px;
    }
    .dropdown-menu a {
      font-size: 1.05rem;
      padding: 8px 0;
      color: rgba(247, 238, 221, 0.85);
    }
  }

  @media (max-width: 600px) {
    .nav-row {
      padding: 8px 18px;
      gap: 10px;
    }
    .header-actions {
      gap: 10px;
    }
    .phone-link {
      display: none;
    }
    .cart-dropdown {
      position: fixed;
      top: 84px;
      left: 12px;
      right: 12px;
      width: auto;
      max-width: none;
    }
  }

  @media (max-width: 400px) {
    .header-order-btn {
      padding: 9px 18px;
      font-size: 0.76rem;
    }
  }
</style>

<script>
  import { getCart, getEstimatedTotal, setQty, removeItem, onChange } from '../scripts/cart';

  const navToggle = document.getElementById('navToggle');
  const primaryNav = document.getElementById('primaryNav');
  const navToggleIcon = document.getElementById('navToggleIcon');
  const dropdownItems = Array.from(document.querySelectorAll('.nav-item'));

  const cartItem = document.querySelector<HTMLElement>('.cart-item');
  const cartToggle = document.querySelector<HTMLButtonElement>('.cart-toggle');
  const cartBadge = document.getElementById('cartBadge');
  const cartEmpty = document.getElementById('cartEmpty');
  const cartLines = document.getElementById('cartLines');
  const cartFooter = document.getElementById('cartFooter');
  const cartTotal = document.getElementById('cartTotal');

  const closeDropdown = (item) => {
    item.classList.remove('open');
    item.querySelector('.dropdown-toggle, .cart-toggle')?.setAttribute('aria-expanded', 'false');
  };

  const closeAllDropdowns = () => {
    dropdownItems.forEach(closeDropdown);
    if (cartItem) closeDropdown(cartItem);
  };

  function renderCart() {
    const items = getCart();
    const count = items.reduce((sum, i) => sum + i.qty, 0);

    if (cartBadge) {
      cartBadge.textContent = String(count);
      cartBadge.hidden = count === 0;
    }

    if (cartEmpty) cartEmpty.hidden = items.length > 0;
    if (cartFooter) cartFooter.hidden = items.length === 0;

    if (cartLines) {
      cartLines.innerHTML = items
        .map(
          (item) => `
            <div class="cart-line" data-cart-line data-id="${item.id}">
              <div class="cart-line-info">
                <div class="cart-line-name">${item.name}</div>
                <div class="cart-line-price">${item.price}</div>
              </div>
              <div class="cart-line-controls">
                <button type="button" class="cart-qty-btn" data-cart-decrement aria-label="Decrease quantity">&minus;</button>
                <span class="cart-qty">${item.qty}</span>
                <button type="button" class="cart-qty-btn" data-cart-increment aria-label="Increase quantity">+</button>
                <button type="button" class="cart-line-remove" data-cart-remove aria-label="Remove item">&times;</button>
              </div>
            </div>
          `
        )
        .join('');
    }

    if (cartTotal) cartTotal.textContent = `$${getEstimatedTotal().toFixed(2)}`;
  }

  cartLines?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const line = target.closest<HTMLElement>('[data-cart-line]');
    if (!line) return;
    const id = line.dataset.id ?? '';
    const items = getCart();
    const current = items.find((i) => i.id === id);
    if (!current) return;

    if (target.closest('[data-cart-increment]')) {
      setQty(id, current.qty + 1);
    } else if (target.closest('[data-cart-decrement]')) {
      setQty(id, current.qty - 1);
    } else if (target.closest('[data-cart-remove]')) {
      removeItem(id);
    }
  });

  onChange(renderCart);
  renderCart();

  cartToggle?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (!cartItem) return;
    const isOpen = cartItem.classList.toggle('open');
    cartToggle.setAttribute('aria-expanded', String(!!isOpen));
    dropdownItems.forEach(closeDropdown);
  });

  navToggle?.addEventListener('click', () => {
    const isOpen = primaryNav?.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', String(!!isOpen));
    if (navToggleIcon) {
      navToggleIcon.innerHTML = isOpen
        ? '<use href="#icon-close"/>'
        : '<use href="#icon-menu"/>';
    }
    closeAllDropdowns();
  });

  primaryNav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      primaryNav.classList.remove('open');
      navToggle?.setAttribute('aria-expanded', 'false');
      if (navToggleIcon) navToggleIcon.innerHTML = '<use href="#icon-menu"/>';
      closeAllDropdowns();
    });
  });

  dropdownItems.forEach((item) => {
    const toggle = item.querySelector('.dropdown-toggle');
    toggle?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isOpen = item.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(!!isOpen));
      dropdownItems.forEach((other) => {
        if (other !== item) closeDropdown(other);
      });
      if (cartItem) closeDropdown(cartItem);
    });
  });

  document.addEventListener('click', (e) => {
    const path = e.composedPath();
    dropdownItems.forEach((item) => {
      if (!path.includes(item)) closeDropdown(item);
    });
    if (cartItem && !path.includes(cartItem)) closeDropdown(cartItem);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });
</script>
