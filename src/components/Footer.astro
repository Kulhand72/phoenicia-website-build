---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-logo">
      <svg viewBox="0 0 100 100"><use href="#icon-sunmark" /></svg>
      Phoenicia Mediterranean Deli
    </div>
    <a
      class="footer-address"
      href="https://www.google.com/maps/search/?api=1&query=Phoenicia+Mediterranean+Deli+15344+Manchester+Rd+Ballwin+MO"
      target="_blank"
      rel="noopener"
    >
      <svg viewBox="0 0 24 24"><use href="#icon-pin" /></svg>
      15344 Manchester Rd, Ballwin, MO 63011
    </a>
    <span class="footer-copy">&copy; {year} Phoenicia Mediterranean Deli</span>
  </div>
</footer>

<style>
  .site-footer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 150;
    background: var(--aegean-deep);
    color: rgba(247, 238, 221, 0.7);
    padding: 14px 0;
    box-shadow: 0 -8px 20px rgba(18, 14, 8, 0.18);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .footer-logo {
    font-family: var(--font-display);
    color: var(--sand);
    font-size: 0.95rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-logo svg {
    width: 16px;
    height: 16px;
    color: var(--saffron-soft);
    flex: none;
  }

  .footer-address {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    text-decoration: none;
    color: rgba(247, 238, 221, 0.7);
  }

  .footer-address svg {
    width: 13px;
    height: 13px;
    color: var(--saffron-soft);
    flex: none;
  }

  .footer-address:hover {
    color: var(--saffron-soft);
  }

  .footer-copy {
    font-size: 0.72rem;
  }
</style>
