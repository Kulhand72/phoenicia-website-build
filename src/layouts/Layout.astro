---
import Icons from '../components/Icons.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/base';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'about' | 'menu' | 'cooking-classes' | 'catering' | 'contact';
  chrome?: boolean;
  fitViewport?: boolean;
  footer?: boolean;
}

const {
  title,
  description = "Family-owned Lebanese and Mediterranean deli in Ballwin, MO. Scratch-made hummus, shawarma, falafel, and kanafeh, plus catering and cooking classes.",
  active,
  chrome = true,
  fitViewport = false,
  footer = true,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=GFS+Didot&family=GFS+Neohellenic:wght@400;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Yellowtail&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Phoenicia Mediterranean Deli</title>
  </head>
  <body class={fitViewport ? 'fit-viewport' : ''}>
    <Icons />
    {chrome && <Header active={active} />}
    <main class="page-main">
      <slot />
    </main>
    {chrome && footer && <Footer />}
    <div class="toast" id="orderToast" role="status" aria-live="polite"></div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
  }

  body.fit-viewport {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  body.fit-viewport > .site-header {
    flex: none;
  }

  body.fit-viewport > .page-main {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
</style>

<script>
  import { getCount } from '../scripts/cart';
  import { withBase } from '../lib/base';

  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  function showToast(message: string) {
    const toast = document.getElementById('orderToast');
    if (!toast) return;

    toast.textContent = message;
    toast.classList.add('show');

    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove('show');
    }, 3600);
  }

  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('[data-order-placeholder]');
    if (!target) return;
    e.preventDefault();

    if (getCount() > 0) {
      window.location.href = withBase('/menu/full');
      return;
    }

    showToast('Add items to your cart before checkout.');
  });

  const fixedFooter = document.querySelector<HTMLElement>('.site-footer');
  const pageMain = document.querySelector<HTMLElement>('.page-main');

  if (fixedFooter && pageMain) {
    const resizeObserver = new ResizeObserver(() => {
      pageMain.style.paddingBottom = `${fixedFooter.getBoundingClientRect().height}px`;
    });
    resizeObserver.observe(fixedFooter);
  }
</script>
