---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" active="about">
  <section class="page-banner">
    <div class="page-banner-inner">
      <div class="eyebrow">
        <svg class="mark" viewBox="0 0 100 100"><use href="#icon-sunmark" /></svg>
        About Us
      </div>
      <h1>Scratch-made Lebanese cooking, done the slow way.</h1>
    </div>
  </section>

  <section>
    <div class="wrap about-grid">
      <div>
        <p class="body-copy">
          Phoenicia is a family-owned Mediterranean deli in Ballwin, bringing a distinct Lebanese
          touch to the area&rsquo;s Mediterranean food scene. Everything on the menu is made from
          scratch &mdash; fresh herbs, plant-based ingredients, and olive oil, prepared daily
          rather than shipped in.
        </p>
        <p class="body-copy" style="margin-top: 16px;">
          The kitchen turns out the full range of Lebanese home cooking: hummus, baba ghanouj, and
          kibbeh alongside grilled shawarma, kabobs, and fresh-baked manakish, with vegetarian and
          vegan options throughout. Phoenicia also caters events of any size and offers hands-on
          Mediterranean cooking classes by request.
        </p>
        <div class="about-facts">
          <div>
            <div class="num">100%</div>
            <div class="lbl">Scratch-made recipes</div>
          </div>
          <div>
            <div class="num">VG</div>
            <div class="lbl">Vegetarian &amp; vegan options</div>
          </div>
          <div>
            <div class="num">Est.</div>
            <div class="lbl">Family-owned, Ballwin</div>
          </div>
        </div>
      </div>
      <div class="about-photo media-placeholder">
        <span>Storefront or team photo placeholder</span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .mark {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .body-copy {
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .about-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
  }

  .about-facts {
    margin-top: 24px;
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
  }

  .about-facts div {
    border-left: 2px solid var(--clay);
    padding-left: 12px;
  }

  .about-facts .num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--clay);
  }

  .about-facts .lbl {
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  @media (max-width: 980px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
