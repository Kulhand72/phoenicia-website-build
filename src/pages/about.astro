---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/base';
---

<Layout title="About" active="about" fitViewport>
  <section class="about-split">
    <div class="about-text-col">
      <h1>About Phoenicia</h1>
      <p class="body-copy">
        Phoenicia is a family-owned Mediterranean deli in Ballwin, serving authentic Lebanese
        flavors made fresh from scratch every day. We use fresh herbs, quality ingredients, and
        traditional Mediterranean cooking methods to create food that tastes homemade&mdash;not
        mass-produced.
      </p>
      <p class="body-copy">
        Enjoy Lebanese favorites like hummus, baba ghanouj, kibbeh, shawarma, kabobs, and
        fresh-baked manakish, with vegetarian and vegan choices available. Phoenicia also caters
        events of any size and offers hands-on Mediterranean cooking classes by request.
      </p>
      <p class="body-copy">Welcome to our restaurant! We are happy to serve you!</p>
      <p class="signature">&mdash; Sam (Owner)</p>
    </div>
    <div
      class="about-photo-col"
      role="img"
      aria-label="The interior of the Phoenicia Mediterranean Deli cafe"
      style={`background-image: url('${withBase('/phoenicia-about-inside-cafe.png')}')`}
    >
    </div>
  </section>
</Layout>

<style>
  .about-split {
    display: grid !important;
    grid-template-columns: 45% 55% !important;
    width: 100% !important;
    max-width: 100% !important;
    flex: 1 1 auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  .about-text-col {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    background: #3b5323 !important;
    color: var(--sand);
    padding: 1rem 3rem 0.5rem !important;
  }

  .about-text-col h1 {
    font-weight: 700 !important;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: 3.9rem !important;
    color: #ffffff !important;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.92), 0 6px 22px rgba(0, 0, 0, 0.75);
    margin-bottom: 3.05rem !important;
    text-align: center !important;
  }

  .body-copy {
    font-size: 2.325rem !important;
    font-weight: 600 !important;
    line-height: 1.08 !important;
    color: #ffffff !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
    margin-bottom: 1.7rem !important;
  }

  .body-copy:last-child {
    margin-bottom: 0;
  }

  .signature {
    font-size: 2.325rem !important;
    font-style: italic !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
    text-align: center !important;
    margin-top: auto !important;
    margin-bottom: 0 !important;
    padding-top: 0.2rem;
    opacity: 0.95;
  }

  .about-photo-col {
    width: 100% !important;
    height: 100% !important;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat;
  }

  @media (max-width: 900px) {
    :global(body.fit-viewport) {
      height: auto;
      overflow: visible;
    }

    .about-split {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .about-text-col {
      padding: 2rem 1.5rem;
    }

    .about-photo-col {
      min-height: 320px;
    }
  }

  @media (max-width: 480px) {
    .about-text-col {
      padding: 1.5rem 1.25rem;
    }

    .about-text-col h1 {
      margin-bottom: 18px;
    }

    .body-copy {
      font-size: 1.3rem;
    }

    .signature {
      font-size: 1.15rem !important;
      padding-top: 1rem;
    }

    .about-photo-col {
      min-height: 260px;
    }
  }
</style>
