---
import Layout from '../../layouts/Layout.astro';
import { MENU } from '../../data/menu';
import { withBase } from '../../lib/base';

function slugify(s: string) {
  return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

const VEGAN_MENU = MENU
  .map((cat) => ({ ...cat, items: cat.items.filter((item) => item.tag === 'V') }))
  .filter((cat) => cat.items.length > 0);
---

<Layout title="Vegan Menu" active="menu">
  <section class="menu-page-head">
    <div class="wrap menu-page-head-row">
      <h1>Vegan Menu</h1>
      <div class="menu-page-head-cta">
        <span class="menu-page-head-lead">For the main menu, click here:</span>
        <a class="menu-page-head-btn" href={withBase('/menu/full')}>Main Menu</a>
      </div>
    </div>
    <div class="wrap">
      <p class="menu-page-head-note">All items below are marked <span class="v-letter">V</span> for Vegan.</p>
    </div>
  </section>

  <section class="vegan-jump-sticky">
    <div class="wrap">
      <div class="vegan-jump" id="veganJump">
        {VEGAN_MENU.map((cat, i) => (
          <a class={'menu-tab' + (i === 0 ? ' active' : '')} href={'#section-' + cat.id} data-jump-target={'section-' + cat.id}>
            {cat.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="menu-divider" aria-hidden="true">
    <span class="menu-divider-line"></span>
    <svg class="menu-divider-mark" viewBox="0 0 32 24">
      <circle cx="4" cy="12" r="2.5" fill="currentColor" />
      <path d="M16 2 L22 12 L16 22 L10 12 Z" fill="currentColor" />
      <circle cx="28" cy="12" r="2.5" fill="currentColor" />
    </svg>
    <span class="menu-divider-line"></span>
  </div>

  <section class="menu-content" style="padding-top: 32px;">
    <div class="wrap">
      {VEGAN_MENU.map((cat) => (
        <div class="menu-panel-section" id={'section-' + cat.id}>
          <div class="menu-panel-head">
            <h2>{cat.title}</h2>
          </div>
          <div class="menu-grid">
            {cat.items.map((item) => (
              <div class="menu-item">
                <div class="menu-item-text">
                  <div class="menu-item-name">
                    {item.n}
                    <span class="tag">{item.tag}</span>
                  </div>
                  {item.d && <div class="menu-item-desc">{item.d}</div>}
                </div>
                <div class="menu-item-actions">
                  <div class="menu-item-price">{item.p}</div>
                  <button
                    type="button"
                    class="add-cart-btn"
                    data-add-to-cart
                    data-item-id={`${cat.id}-${slugify(item.n)}`}
                    data-item-name={item.n}
                    data-item-price={item.p}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-cart" /></svg>
                    <span class="add-cart-label">Add</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="menu-divider menu-divider--inline" aria-hidden="true">
        <span class="menu-divider-line"></span>
        <svg class="menu-divider-mark" viewBox="0 0 32 24">
          <circle cx="4" cy="12" r="2.5" fill="currentColor" />
          <path d="M16 2 L22 12 L16 22 L10 12 Z" fill="currentColor" />
          <circle cx="28" cy="12" r="2.5" fill="currentColor" />
        </svg>
        <span class="menu-divider-line"></span>
      </div>
    </div>
  </section>
</Layout>

<style>
  h2 {
    font-family: 'Playfair Display', Georgia, serif;
  }

  p {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .menu-page-head {
    padding: 32px 0 0;
    background: #ffffff;
  }

  .menu-page-head-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .menu-page-head h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3.35rem;
    color: var(--ink);
  }

  .menu-page-head-cta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .menu-page-head-lead {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .menu-page-head-note {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin: 6px 0 0;
  }

  .v-letter {
    font-size: 0.95rem;
    font-weight: 800;
    color: #2e7d32;
  }

  .tag {
    font-size: 0.95rem;
    font-weight: 800;
    color: #2e7d32;
    background: rgba(46, 125, 50, 0.12);
  }

  .menu-page-head-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: #fbeee9;
    background: linear-gradient(180deg, #9e1b1e 0%, #6b0c0f 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 12px 24px;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(60, 10, 10, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .menu-page-head-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(60, 10, 10, 0.36);
  }

  .vegan-jump-sticky {
    position: sticky;
    top: 81px;
    z-index: 90;
    background: #ffffff;
    padding: 18px 0;
  }

  .vegan-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  :global(.vegan-jump .menu-tab) {
    display: inline-flex;
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 9px 17px;
    border-radius: 999px;
    border: 1.5px solid var(--olive);
    background: transparent;
    color: var(--olive);
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  :global(.vegan-jump .menu-tab:hover) {
    transform: translateY(-1px);
    border-color: #424d26;
  }

  :global(.vegan-jump .menu-tab.active) {
    background: linear-gradient(180deg, var(--olive) 0%, #424d26 100%);
    border-color: #424d26;
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(66, 77, 38, 0.32);
  }

  .menu-divider {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0 28px;
    color: #9e1b1e;
  }

  .menu-divider-line {
    flex: 1 1 auto;
    height: 2px;
    background: currentColor;
  }

  .menu-divider-mark {
    flex: none;
    width: 48px;
    height: 24px;
    margin: 0 4px;
  }

  .menu-divider--inline {
    padding: 0;
    margin: 24px 0 36px;
  }

  .menu-content {
    background: #ffffff;
  }

  :global(body) {
    background: #ffffff;
  }

  .menu-panel-section {
    scroll-margin-top: 160px;
    margin-bottom: 40px;
  }

  .menu-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .menu-panel-head h2 {
    font-size: 2.07rem;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 36px;
  }

  .menu-item {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .menu-item-text {
    max-width: 70%;
  }

  .menu-item-name {
    font-weight: 600;
    font-size: 1.08rem;
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
  }

  .menu-item-desc {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink-soft);
    margin-top: 4px;
  }

  .menu-item-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex: none;
  }

  .menu-item-price {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1.2rem;
    white-space: nowrap;
    color: var(--clay);
  }

  .add-cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--olive);
    background: transparent;
    border: 1.5px solid var(--olive);
    border-radius: 999px;
    padding: 5px 12px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .add-cart-btn svg {
    width: 13px;
    height: 13px;
  }

  .add-cart-btn:hover {
    background: var(--olive);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .add-cart-btn.added {
    background: var(--olive);
    color: #ffffff;
  }

  @media (max-width: 760px) {
    .menu-grid {
      grid-template-columns: 1fr;
    }
    .menu-item-text {
      max-width: 100%;
    }
  }
</style>

<script>
  const jumpLinks = document.querySelectorAll<HTMLAnchorElement>('.vegan-jump .menu-tab');
  const sections = document.querySelectorAll<HTMLDivElement>('.menu-panel-section');

  jumpLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      const targetId = link.dataset.jumpTarget;
      const target = targetId ? document.getElementById(targetId) : null;
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  if (sections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          jumpLinks.forEach((link) => {
            link.classList.toggle('active', link.dataset.jumpTarget === entry.target.id);
          });
        });
      },
      { rootMargin: '-170px 0px -70% 0px', threshold: 0 }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
