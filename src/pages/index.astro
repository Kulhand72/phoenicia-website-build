---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome" chrome={false}>
  <main class="splash">
    <div class="splash-inner">
      <div class="mark">
        <svg viewBox="0 0 100 100"><use href="#icon-sunmark" /></svg>
      </div>
      <h1>Phoenicia</h1>
      <p class="tagline">Mediterranean Deli &middot; Ballwin, Missouri</p>
      <div class="loader" aria-hidden="true"><span></span></div>
    </div>
    <noscript>
      <p class="noscript-link"><a href="/home">Continue to the site &rarr;</a></p>
    </noscript>
  </main>
</Layout>

<style>
  .splash {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 30% 20%, rgba(227, 168, 59, 0.25) 0%, transparent 55%),
      radial-gradient(circle at 75% 80%, rgba(193, 89, 43, 0.28) 0%, transparent 55%),
      var(--aegean-deep);
    color: var(--sand);
    text-align: center;
    padding: 24px;
  }

  .splash-inner {
    animation: rise 0.7s ease both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mark {
    width: 68px;
    height: 68px;
    margin: 0 auto 20px;
    color: var(--saffron);
    animation: spin-in 1.1s ease both;
  }

  .mark svg {
    width: 100%;
    height: 100%;
  }

  @keyframes spin-in {
    from {
      opacity: 0;
      transform: rotate(-40deg) scale(0.7);
    }
    to {
      opacity: 1;
      transform: rotate(0) scale(1);
    }
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 3.4rem);
    letter-spacing: 0.01em;
  }

  .tagline {
    margin-top: 10px;
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(247, 238, 221, 0.72);
    font-weight: 600;
  }

  .loader {
    margin: 34px auto 0;
    width: 120px;
    height: 3px;
    background: rgba(247, 238, 221, 0.18);
    border-radius: 3px;
    overflow: hidden;
  }

  .loader span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--saffron);
    transform: translateX(-100%);
    animation: fill 2.4s ease forwards;
  }

  @keyframes fill {
    to {
      transform: translateX(0);
    }
  }

  .noscript-link {
    position: absolute;
    bottom: 40px;
    left: 0;
    right: 0;
    text-align: center;
  }

  .noscript-link a {
    color: var(--saffron-soft);
    font-weight: 700;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-inner,
    .mark,
    .loader span {
      animation: none;
    }
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 900 : 2600;

  if (!params.has('noskip')) {
    setTimeout(() => {
      window.location.href = '/home';
    }, delay);
  }
</script>
