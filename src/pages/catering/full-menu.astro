---

<Layout title="Catering Full Menu" active="catering">
  <section class="menu-page-head">
    <div class="wrap menu-page-head-row">
      <h1>Catering Full Menu</h1>
      <div class="menu-page-head-cta">
        <span class="menu-page-head-lead">For the main menu, click here:</span>
        <a class="menu-page-head-btn" href={withBase('/menu/full')}>Main Menu</a>
      </div>
    </div>
  </section>

  <section class="menu-tabs-sticky">
    <div class="wrap">
      <div class="menu-tabs" id="menuTabs" role="tablist">
        {CATERING_MENU.map((cat, i) => (
          <button
            type="button"
            class={'menu-tab' + (i === 0 ? ' active' : '')}
            data-target={cat.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <div class="menu-divider" aria-hidden="true">
    <span class="menu-divider-line"></span>
    <svg class="menu-divider-mark" viewBox="0 0 32 24">
      <circle cx="4" cy="12" r="2.5" fill="currentColor" />
      <path d="M16 2 L22 12 L16 22 L10 12 Z" fill="currentColor" />
      <circle cx="28" cy="12" r="2.5" fill="currentColor" />
    </svg>
    <span class="menu-divider-line"></span>
  </div>

  <section class="menu-content" style="padding-top: 32px;">
    <div class="wrap">
      <div id="menuPanels">
        {CATERING_MENU.map((cat, i) => (
          <div class={'menu-panel' + (i === 0 ? ' active' : '')} id={'panel-' + cat.id} role="tabpanel">
            <div class="menu-panel-head">
              <h2>{cat.title}</h2>
              {cat.note && <div class="menu-panel-note">{cat.note}</div>}
            </div>
            {cat.items ? (
              <div class="menu-grid">
                {cat.items.map((item) => (
                  <div class="menu-item">
                    <div class="menu-item-text">
                      <div class="menu-item-name">{item.n}</div>
                      {item.d && <div class="menu-item-desc">{item.d}</div>}
                    </div>
                    <div class="menu-item-actions">
                      <div class="menu-item-price">{item.p}</div>
                      <button
                        type="button"
                        class="add-cart-btn"
                        data-add-to-cart
                        data-item-id={`${cat.id}-${slugify(item.n)}`}
                        data-item-name={item.n}
                        data-item-price={item.p}
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-cart" /></svg>
                        <span class="add-cart-label">Add</span>
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            ) : cat.tiers ? (
              <div class="tier-list">
                {cat.tiers.map((tier) => (
                  <div class="tier-block">
                    <div class="tier-head">
                      <h3>{tier.label}</h3>
                      <div class="tier-meta">{tier.formula} &middot; <span class="tier-price">{tier.price}</span></div>
                    </div>
                    <div class="menu-grid">
                      {tier.items.map((item) => (
                        <div class="menu-item">
                          <div class="menu-item-text">
                            <div class="menu-item-name">{item}</div>
                          </div>
                          <div class="menu-item-actions">
                            <div class="menu-item-price">{tier.price}</div>
                            <button
                              type="button"
                              class="add-cart-btn"
                              data-add-to-cart
                              data-item-id={`${cat.id}-${slugify(tier.label)}-${slugify(item)}`}
                              data-item-name={item}
                              data-item-price={tier.price}
                            >
                              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-cart" /></svg>
                              <span class="add-cart-label">Add</span>
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="menu-panel-placeholder">Menu items coming soon.</p>
            )}
          </div>
        ))}
      </div>

      <div class="menu-divider menu-divider--inline" aria-hidden="true">
        <span class="menu-divider-line"></span>
        <svg class="menu-divider-mark" viewBox="0 0 32 24">
          <circle cx="4" cy="12" r="2.5" fill="currentColor" />
          <path d="M16 2 L22 12 L16 22 L10 12 Z" fill="currentColor" />
          <circle cx="28" cy="12" r="2.5" fill="currentColor" />
        </svg>
        <span class="menu-divider-line"></span>
      </div>

      <div class="catering-cta">
        <button type="button" class="catering-cta-btn">Contact Us About Catering</button>
      </div>
    </div>
  </section>
</Layout>

<style>
  h2,
  h3 {
    font-family: 'Playfair Display', Georgia, serif;
  }

  p {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .menu-page-head {
    padding: 32px 0 0;
    background: #ffffff;
  }

  .menu-page-head-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .menu-page-head h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.1rem;
    color: var(--ink);
  }

  .menu-page-head-cta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .menu-page-head-lead {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .menu-page-head-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: #fbeee9;
    background: linear-gradient(180deg, #9e1b1e 0%, #6b0c0f 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 12px 24px;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(60, 10, 10, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .menu-page-head-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(60, 10, 10, 0.36);
  }

  .menu-tabs-sticky {
    position: sticky;
    top: 81px;
    z-index: 90;
    background: #ffffff;
    padding: 18px 0;
  }

  .menu-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .menu-tab {
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 9px 17px;
    border-radius: 999px;
    border: 1.5px solid var(--olive);
    background: transparent;
    color: var(--olive);
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .menu-tab:hover {
    transform: translateY(-1px);
    border-color: #424d26;
  }

  .menu-tab.active {
    background: linear-gradient(180deg, var(--olive) 0%, #424d26 100%);
    border-color: #424d26;
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(66, 77, 38, 0.32);
  }

  .menu-divider {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0 28px;
    color: #9e1b1e;
  }

  .menu-divider-line {
    flex: 1 1 auto;
    height: 2px;
    background: currentColor;
  }

  .menu-divider-mark {
    flex: none;
    width: 48px;
    height: 24px;
    margin: 0 4px;
  }

  .menu-divider--inline {
    padding: 0;
    margin: 24px 0 36px;
  }

  .menu-content {
    background: #ffffff;
  }

  :global(body) {
    background: #ffffff;
  }

  .menu-panel {
    display: none;
  }

  .menu-panel.active {
    display: block;
  }

  .menu-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .menu-panel-head h2 {
    font-size: 1.8rem;
  }

  .menu-panel-note {
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  .menu-panel-placeholder {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink-soft);
    font-style: italic;
    padding: 16px 0;
  }

  .tier-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .tier-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 8px;
    margin-bottom: 4px;
    border-bottom: 2px solid var(--olive);
  }

  .tier-head h3 {
    font-size: 1.25rem;
    color: var(--olive);
  }

  .tier-meta {
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  .tier-price {
    font-style: normal;
    font-weight: 700;
    color: var(--clay);
  }

  .menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 36px;
  }

  .menu-item {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .menu-item-text {
    max-width: 70%;
  }

  .menu-item-name {
    font-weight: 600;
    font-size: 1.08rem;
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
  }

  .menu-item-desc {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink-soft);
    margin-top: 4px;
  }

  .menu-item-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex: none;
  }

  .menu-item-price {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1.2rem;
    white-space: nowrap;
    color: var(--clay);
  }

  .add-cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--olive);
    background: transparent;
    border: 1.5px solid var(--olive);
    border-radius: 999px;
    padding: 5px 12px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .add-cart-btn svg {
    width: 13px;
    height: 13px;
  }

  .add-cart-btn:hover {
    background: var(--olive);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .add-cart-btn.added {
    background: var(--olive);
    color: #ffffff;
  }

  @media (max-width: 760px) {
    .menu-grid {
      grid-template-columns: 1fr;
    }
    .menu-item-text {
      max-width: 100%;
    }
  }

  .catering-cta {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  .catering-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: #fbeee9;
    background: linear-gradient(180deg, #9e1b1e 0%, #6b0c0f 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 14px 30px;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgba(60, 10, 10, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .catering-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(60, 10, 10, 0.36);
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.menu-tab');
  const panels = document.querySelectorAll<HTMLDivElement>('.menu-panel');

  function activate(id: string) {
    tabs.forEach((t) => {
      const isActive = t.dataset.target === id;
      t.classList.toggle('active', isActive);
      t.setAttribute('aria-selected', String(isActive));
    });
    panels.forEach((p) => {
      p.classList.toggle('active', p.id === 'panel-' + id);
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activate(tab.dataset.target ?? ''));
  });

  function activateFromHash() {
    const hashId = window.location.hash.replace('#', '');
    if (hashId && document.getElementById('panel-' + hashId)) {
      activate(hashId);
    }
  }

  activateFromHash();
  window.addEventListener('hashchange', activateFromHash);
</script>
