---
import Layout from '../../layouts/Layout.astro';

const CATERING_MENU = [
  {
    id: 'bulk-trays',
    label: 'Bulk Trays & Appetizers',
    title: 'Bulk Trays & Appetizers',
    items: [
      { n: 'Vegetarian Grape Leaves (50 pieces)', p: '$50.00' },
      { n: 'Meat Grape Leaves (50 pieces)', p: '$50.00' },
      { n: 'Kibbeh (per piece)', d: 'Crispy bulgur wheat shell stuffed with spiced beef and toasted pine nuts, fried or baked.', p: '$3.00' },
      { n: 'Gyro Lamb (per lb, 4lb tray $100)', d: 'Meat cooked on a vertical rotisserie, sliced and served wrapped or stuffed in pita.', p: '$25.00/lb' },
      { n: 'Beef Shawarma (per lb, 4lb tray $100)', d: 'Beef marinated with cumin, cardamom, and paprika.', p: '$25.00/lb' },
      { n: 'Chicken Shawarma (per lb, 4lb tray $100)', d: 'Chicken marinated with cumin, cardamom, and paprika.', p: '$25.00/lb' },
      { n: 'Chicken Kabob (skewer, 4 pieces, minimum 10 skewers)', d: 'Seasoned chicken cubes grilled to perfection.', p: '$6.00' },
      { n: 'Beef Kabob (skewer, 4 pieces, minimum 10 skewers)', d: 'Seasoned beef cubes grilled to perfection.', p: '$7.00' },
      { n: 'Kofta Kabob (skewer, minimum 10 skewers)', d: 'Spiced beef formed on a skewer and grilled, kabob-style.', p: '$6.00' },
      { n: 'Greek Salad or Fattoush (half tray, 7 lbs)', d: 'Tomatoes, cucumbers, onion, feta cheese, and olives, dressed with oregano and lemon juice.', p: '$65.00' },
      { n: 'Tabbouleh (half tray, 5 lbs)', d: 'Finely chopped parsley, soaked bulgur, tomatoes, mint, and scallions.', p: '$70.00' },
      { n: 'Yellow Rice (half tray)', d: 'Fluffy long grain basmati rice with special seasonings.', p: '$35.00' },
      { n: 'Yellow Rice + Chicken Shawarma (half tray)', p: '$85.00' },
      { n: 'Yellow Rice + Beef Shawarma (half tray)', p: '$85.00' },
      { n: 'Ouzy — white rice with lamb (half tray)', p: '$100.00' },
      { n: 'Chicken Biryani (half tray)', p: '$70.00' },
      { n: 'Falafel (50 pieces)', d: 'Deep-fried chickpea balls, served with tahini-based sauces.', p: '$40.00' },
      { n: 'Hummus (half tray, 5 lbs)', d: 'Mashed chickpeas blended with tahini, lemon juice, and garlic.', p: '$55.00' },
      { n: 'Baba Ghanoush (half tray, 5 lbs)', d: 'Roasted eggplant, olive oil, lemon juice, tahini.', p: '$65.00' },
      { n: 'Batata Harra (half tray)', d: 'Spiced sautéed potatoes with garlic and cilantro.', p: '$60.00' },
      { n: 'Baklawa (20 pieces)', d: 'Layered phyllo pastry with nuts and honey syrup.', p: '$50.00' },
      { n: 'Kanafeh Half Tray (6 large pieces/squares)', d: 'Sweet cheese pastry soaked in syrup, topped with crushed pistachio.', p: '$60.00' },
    ],
  },
  {
    id: 'fatayer-pies',
    label: 'Fatayer Pies',
    title: 'Fatayer Pies',
    note: 'Fatayer are savory pies; the most common varieties include spinach, meat, and cheese. Part of Levantine cuisine.',
    items: [
      { n: 'Zaatar Pies (dozen)', p: '$15.00' },
      { n: 'Cheese Pies or Rolls (dozen)', p: '$24.00' },
      { n: 'Spinach Pies / Spinach Cheese Pies (dozen)', p: '$24.00' },
      { n: 'Meat Pies (dozen)', p: '$24.00' },
    ],
  },
  { id: 'meeting-boxes', label: 'Meeting Gourmet Boxes', title: 'Meeting Gourmet Boxes' },
  { id: 'ready-to-eat-meals', label: 'Ready-to-Eat Meals', title: 'Ready-to-Eat Meals' },
];
---

<Layout title="Catering Full Menu" active="catering">
  <section class="menu-tabs-sticky">
    <div class="wrap">
      <div class="menu-tabs" id="menuTabs" role="tablist">
        {CATERING_MENU.map((cat, i) => (
          <button
            type="button"
            class={'menu-tab' + (i === 0 ? ' active' : '')}
            data-target={cat.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <div class="menu-divider" aria-hidden="true">
    <span class="menu-divider-line"></span>
    <svg class="menu-divider-mark" viewBox="0 0 32 24">
      <circle cx="4" cy="12" r="2.5" fill="currentColor" />
      <path d="M16 2 L22 12 L16 22 L10 12 Z" fill="currentColor" />
      <circle cx="28" cy="12" r="2.5" fill="currentColor" />
    </svg>
    <span class="menu-divider-line"></span>
  </div>

  <section class="menu-content" style="padding-top: 32px;">
    <div class="wrap">
      <div id="menuPanels">
        {CATERING_MENU.map((cat, i) => (
          <div class={'menu-panel' + (i === 0 ? ' active' : '')} id={'panel-' + cat.id} role="tabpanel">
            <div class="menu-panel-head">
              <h2>{cat.title}</h2>
              {cat.note && <div class="menu-panel-note">{cat.note}</div>}
            </div>
            {cat.items ? (
              <div class="menu-grid">
                {cat.items.map((item) => (
                  <div class="menu-item">
                    <div class="menu-item-text">
                      <div class="menu-item-name">{item.n}</div>
                      {item.d && <div class="menu-item-desc">{item.d}</div>}
                    </div>
                    <div class="menu-item-price">{item.p}</div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="menu-panel-placeholder">Menu items coming soon.</p>
            )}
          </div>
        ))}
      </div>

      <div class="menu-divider menu-divider--inline" aria-hidden="true">
        <span class="menu-divider-line"></span>
        <svg class="menu-divider-mark" viewBox="0 0 32 24">
          <circle cx="4" cy="12" r="2.5" fill="currentColor" />
          <path d="M16 2 L22 12 L16 22 L10 12 Z" fill="currentColor" />
          <circle cx="28" cy="12" r="2.5" fill="currentColor" />
        </svg>
        <span class="menu-divider-line"></span>
      </div>

      <div class="catering-cta">
        <button type="button" class="catering-cta-btn">Contact Us About Catering</button>
      </div>
    </div>
  </section>
</Layout>

<style>
  h2 {
    font-family: 'Playfair Display', Georgia, serif;
  }

  p {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .menu-tabs-sticky {
    position: sticky;
    top: 81px;
    z-index: 90;
    background: #ffffff;
    padding: 18px 0;
  }

  .menu-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .menu-tab {
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 9px 17px;
    border-radius: 999px;
    border: 1.5px solid var(--olive);
    background: transparent;
    color: var(--olive);
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .menu-tab:hover {
    transform: translateY(-1px);
    border-color: #424d26;
  }

  .menu-tab.active {
    background: linear-gradient(180deg, var(--olive) 0%, #424d26 100%);
    border-color: #424d26;
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(66, 77, 38, 0.32);
  }

  .menu-divider {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0 28px;
    color: #9e1b1e;
  }

  .menu-divider-line {
    flex: 1 1 auto;
    height: 2px;
    background: currentColor;
  }

  .menu-divider-mark {
    flex: none;
    width: 48px;
    height: 24px;
    margin: 0 4px;
  }

  .menu-divider--inline {
    padding: 0;
    margin: 24px 0 36px;
  }

  .menu-content {
    background: #ffffff;
  }

  :global(body) {
    background: #ffffff;
  }

  .menu-panel {
    display: none;
  }

  .menu-panel.active {
    display: block;
  }

  .menu-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .menu-panel-head h2 {
    font-size: 1.8rem;
  }

  .menu-panel-note {
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  .menu-panel-placeholder {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink-soft);
    font-style: italic;
    padding: 16px 0;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 36px;
  }

  .menu-item {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .menu-item-text {
    max-width: 70%;
  }

  .menu-item-name {
    font-weight: 600;
    font-size: 1.08rem;
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
  }

  .menu-item-desc {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink-soft);
    margin-top: 4px;
  }

  .menu-item-price {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1.2rem;
    white-space: nowrap;
    color: var(--clay);
  }

  @media (max-width: 760px) {
    .menu-grid {
      grid-template-columns: 1fr;
    }
    .menu-item-text {
      max-width: 100%;
    }
  }

  .catering-cta {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  .catering-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: #fbeee9;
    background: linear-gradient(180deg, #9e1b1e 0%, #6b0c0f 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 14px 30px;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgba(60, 10, 10, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .catering-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(60, 10, 10, 0.36);
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.menu-tab');
  const panels = document.querySelectorAll<HTMLDivElement>('.menu-panel');

  function activate(id: string) {
    tabs.forEach((t) => {
      const isActive = t.dataset.target === id;
      t.classList.toggle('active', isActive);
      t.setAttribute('aria-selected', String(isActive));
    });
    panels.forEach((p) => {
      p.classList.toggle('active', p.id === 'panel-' + id);
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activate(tab.dataset.target ?? ''));
  });

  function activateFromHash() {
    const hashId = window.location.hash.replace('#', '');
    if (hashId && document.getElementById('panel-' + hashId)) {
      activate(hashId);
    }
  }

  activateFromHash();
  window.addEventListener('hashchange', activateFromHash);
</script>
