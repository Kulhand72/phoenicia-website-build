---
import Layout from '../layouts/Layout.astro';
import menuBg from '../assets/menu-landing-bg.jpg';
---

<Layout title="Menu" active="menu" fitViewport>
  <section class="menu-hero">
    <img
      src={menuBg.src}
      width={menuBg.width}
      height={menuBg.height}
      alt="An evening spread of Phoenicia Mediterranean dishes"
      class="menu-hero-bg"
      loading="eager"
      fetchpriority="high"
    />
    <div class="menu-hero-inner">
      <h1>Our Menu</h1>
      <a href="/menu/full" class="menu-btn">See the Full Menu</a>
    </div>
  </section>
</Layout>

<style>
  .menu-hero {
    position: relative;
    overflow: hidden;
    flex: 1 1 auto;
    min-height: 0;
    padding: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .menu-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    z-index: 0;
  }

  .menu-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    text-align: center;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8), 0 1px 3px rgba(0,0,0,0.9);
    background-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.3) 45%, rgba(0, 0, 0, 0) 75%) !important;
    box-shadow: none !important;
    padding: 2.5rem !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
  }

  @media (max-width: 900px) {
    .menu-hero-inner {
      padding-top: 50px;
    }
  }

  @media (max-width: 480px) {
    .menu-hero-inner {
      padding-top: 30px;
    }
  }

  .menu-hero-inner h1 {
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.02;
    white-space: nowrap;
    font-size: clamp(1.1rem, 4.9vw, 4.2rem);
    color: var(--sand);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.92), 0 6px 22px rgba(0, 0, 0, 0.75);
    margin-bottom: 63px;
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #fbeee9;
    background: linear-gradient(180deg, #9e1b1e 0%, #6b0c0f 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: clamp(16px, 2.4vh, 22px) clamp(40px, 5.5vw, 58px);
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 12px 26px rgba(60, 10, 10, 0.38);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .menu-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(60, 10, 10, 0.46);
  }
</style>
