---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Catering" active="catering">
  <section class="page-banner">
    <div class="page-banner-inner">
      <div class="eyebrow">
        <svg class="mark" viewBox="0 0 100 100"><use href="#icon-sunmark" /></svg>
        Catering &amp; Events
      </div>
      <h1>Feed your next gathering, from ten guests to a hundred.</h1>
      <p>
        Phoenicia caters hot and cold breakfast, lunch, dinner, snacks, and appetizers, with a
        dedicated catering crew for setup and service.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap catering-grid">
      <div>
        <ul class="catering-list">
          <li>
            <svg viewBox="0 0 24 24"><use href="#icon-cal" /></svg>
            <div>
              <h4>Event Planning</h4>
              <p>
                Work directly with Phoenicia&rsquo;s event planner to design a menu for gatherings
                of any size, from small meetings to large-scale conferences.
              </p>
            </div>
          </li>
          <li>
            <svg viewBox="0 0 24 24"><use href="#icon-tray" /></svg>
            <div>
              <h4>Bulk &amp; Tray Orders</h4>
              <p>
                Half-trays and full trays of hummus, tabbouleh, Greek salad, falafel, and shawarma
                by the pound, priced for groups.
              </p>
            </div>
          </li>
          <li>
            <svg viewBox="0 0 24 24"><use href="#icon-leaf" /></svg>
            <div>
              <h4>Boxed Lunches</h4>
              <p>
                Individually packaged sandwich boxes with dessert, napkins, and utensils &mdash;
                minimum 10 boxes, priced at $16.99 each.
              </p>
            </div>
          </li>
          <li>
            <svg viewBox="0 0 24 24"><use href="#icon-tray" /></svg>
            <div>
              <h4>Cooking Classes</h4>
              <p>
                Hands-on Mediterranean cooking classes, $55 per person. Send an inquiry through the
                <a href="/contact">contact page</a> or call to check current availability and book a date.
              </p>
            </div>
          </li>
        </ul>
      </div>
      <div class="catering-panel">
        <h3>Popular catering picks</h3>
        <p>A sample of what&rsquo;s typically ordered for events. Full pricing and minimums are on the catering menu.</p>
        <div class="catering-sample">
          <div>Hummus, half tray (5 lbs)</div><div>$55.00</div>
          <div>Tabbouleh, half tray (5 lbs)</div><div>$70.00</div>
          <div>Greek salad, half tray (7 lbs)</div><div>$65.00</div>
          <div>Shish Tawook, per skewer (min. 10)</div><div>$6.00</div>
          <div>Falafel, 50 pieces</div><div>$40.00</div>
          <div>Meeting gourmet boxes (min. 10)</div><div>$169.90+</div>
        </div>
        <a href="tel:3147649222" class="btn btn-gold">Call to Book Catering</a>
        <a href="/menu/full#catering-menu" class="btn btn-outline-light" style="margin-top: 12px;">See Full Catering Menu</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .mark {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .catering-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .catering-list {
    list-style: none;
  }

  .catering-list li {
    display: flex;
    gap: 13px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
  }

  .catering-list svg {
    width: 19px;
    height: 19px;
    flex: none;
    color: var(--clay);
    margin-top: 2px;
  }

  .catering-list h4 {
    font-size: 0.97rem;
    font-weight: 700;
  }

  .catering-list p {
    font-size: 0.86rem;
    color: var(--ink-soft);
    margin-top: 3px;
  }

  .catering-list p a {
    color: var(--aegean);
    font-weight: 600;
    text-decoration: none;
  }

  .catering-list p a:hover {
    color: var(--clay);
  }

  .catering-panel {
    background: var(--aegean-deep);
    color: var(--sand);
    border-radius: var(--radius);
    padding: 34px;
    position: relative;
    overflow: hidden;
  }

  .catering-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 15% 20%, rgba(227, 168, 59, 0.16) 0%, transparent 55%);
  }

  .catering-panel > * {
    position: relative;
    z-index: 1;
  }

  .catering-panel h3 {
    font-size: 1.4rem;
    margin-bottom: 12px;
  }

  .catering-panel p {
    color: rgba(247, 238, 221, 0.82);
    font-size: 0.92rem;
    margin-bottom: 24px;
  }

  .catering-sample {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 16px;
    font-size: 0.86rem;
    margin-bottom: 26px;
  }

  .catering-sample div:nth-child(odd) {
    color: rgba(247, 238, 221, 0.75);
  }

  .catering-sample div:nth-child(even) {
    font-family: var(--font-display);
    color: var(--saffron-soft);
    text-align: right;
  }

  .catering-panel .btn {
    width: 100%;
  }

  @media (max-width: 980px) {
    .catering-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
