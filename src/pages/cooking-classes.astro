---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cooking Classes" active="cooking-classes">
  <section class="page-banner">
    <div class="page-banner-inner">
      <div class="eyebrow">
        <svg class="mark" viewBox="0 0 100 100"><use href="#icon-sunmark" /></svg>
        Cooking Classes
      </div>
      <h1>Hands-on Mediterranean cooking classes.</h1>
      <p>
        This page is on its way &mdash; full class details, dates, and a booking form are coming
        soon. In the meantime, call us to ask about availability.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap center" style="max-width: 560px;">
      <p class="body-copy">
        Phoenicia offers hands-on Mediterranean cooking classes, $55 per person, by request. We're
        still building out this page &mdash; check back soon for the full schedule and an online
        inquiry form.
      </p>
      <a href="tel:3147649222" class="btn btn-primary" style="margin-top: 24px;">Call to Ask About Classes</a>
    </div>
  </section>
</Layout>

<style>
  .mark {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .body-copy {
    font-size: 1rem;
    color: var(--ink-soft);
  }
</style>
