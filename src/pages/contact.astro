---
import Layout from '../layouts/Layout.astro';
import storefrontPhoto from '../assets/contact-storefront.jpg';

const INQUIRY_EMAIL = 'harpsoul6@gmail.com';
---

<Layout title="Contact" active="contact">
  <section class="contact-hero">
    <div class="wrap">
      <h1>Find Phoenicia Mediterranean Deli</h1>
    </div>
  </section>

  <section>
    <div class="wrap contact-grid">
      <div class="contact-card card">
        <div class="contact-row">
          <svg viewBox="0 0 24 24"><use href="#icon-pin" /></svg>
          <div>
            <div class="label">Address</div>
            <a
              class="value address-link"
              href="https://www.google.com/maps/search/?api=1&query=Phoenicia+Mediterranean+Deli+15344+Manchester+Rd+Ballwin+MO"
              target="_blank"
              rel="noopener"
            >15344 Manchester Rd, Ballwin, MO 63011</a>
            <a
              class="pill-btn directions-btn"
              href="https://www.google.com/maps/dir/?api=1&destination=Phoenicia+Mediterranean+Deli+15344+Manchester+Rd+Ballwin+MO+63011"
              target="_blank"
              rel="noopener"
            >Directions to Phoenicia</a>
          </div>
        </div>
        <div class="contact-row">
          <svg viewBox="0 0 24 24"><use href="#icon-phone" /></svg>
          <div>
            <div class="label">Phone</div>
            <a class="value" href="tel:3147649222">(314) 764-9222</a>
          </div>
        </div>
        <div class="contact-row">
          <svg viewBox="0 0 24 24"><use href="#icon-clock" /></svg>
          <div>
            <div class="label">Hours</div>
            <div class="value hours-list">
              <div class="hours-line"><span>Monday&ndash;Thursday</span><span>5:00 PM &ndash; 9:00 PM</span></div>
              <div class="hours-line"><span>Friday&ndash;Saturday</span><span>11:00 AM &ndash; 9:00 PM</span></div>
              <div class="hours-line"><span>Sunday</span><span>Closed</span></div>
            </div>
            <p class="hours-note">Sunday hours are unconfirmed &mdash; still need to verify.</p>
          </div>
        </div>
        <div class="contact-row">
          <svg viewBox="0 0 24 24"><use href="#icon-tray" /></svg>
          <div>
            <div class="label">Order</div>
            <button type="button" class="pill-btn order-btn" data-order-placeholder>Order Now</button>
            <p class="order-note">Online ordering coming soon &mdash; call to order for now.</p>
          </div>
        </div>
        <div class="social-row">
          <a
            class="social-btn instagram"
            href="https://www.instagram.com/phoeniciamediterranean/?hl=en"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          ><svg viewBox="0 0 24 24"><use href="#icon-instagram" /></svg></a>
          <a
            class="social-btn facebook"
            href="https://www.facebook.com/pages/category/Mediterranean-Restaurant/Phoenicia-Mediterranean-Deli-401178850234762/"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
          ><svg viewBox="0 0 24 24"><use href="#icon-facebook" /></svg></a>
        </div>
      </div>

      <div
        class="storefront-photo card"
        role="img"
        aria-label="The Phoenicia Mediterranean Deli storefront sign and windows"
      >
        <img
          src={storefrontPhoto.src}
          width={storefrontPhoto.width}
          height={storefrontPhoto.height}
          alt="The Phoenicia Mediterranean Deli storefront sign and windows"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="class-section">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">
          <svg class="mark" viewBox="0 0 100 100"><use href="#icon-sunmark" /></svg>
          Cooking Classes
        </div>
        <h2>Ask about our next Mediterranean cooking class.</h2>
        <p class="section-sub">
          Hands-on classes are $55 per person and booked by request. Send the details below and
          we&rsquo;ll follow up to confirm a date &mdash; this replaces our old sign-up form.
        </p>
      </div>

      <form class="class-form card" id="classForm" novalidate>
        <div class="form-row">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>
        <div class="form-row">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <div class="form-row">
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" />
        </div>
        <div class="form-row two-up">
          <div>
            <label for="date">Preferred Date</label>
            <input type="date" id="date" name="date" />
          </div>
          <div>
            <label for="partySize">Party Size</label>
            <input type="number" id="partySize" name="partySize" min="1" max="30" placeholder="e.g. 4" />
          </div>
        </div>
        <div class="form-row">
          <label for="message">What would you like to learn or celebrate?</label>
          <textarea id="message" name="message" rows="4" placeholder="Tell us about the group and what you're hoping to cook..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send Inquiry</button>
        <p class="form-note">
          Sending this opens your email app with the details filled in, addressed to Phoenicia.
        </p>
      </form>
    </div>
  </section>
</Layout>

<style>
  :global(html body) {
    background: #ffffff;
  }

  .mark {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .contact-hero h1 {
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: clamp(2.2rem, 4.6vw, 3.5rem);
    color: var(--ink);
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: #fbeee9;
    background: linear-gradient(180deg, #9e1b1e 0%, #6b0c0f 100%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 12px 24px;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(60, 10, 10, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pill-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(60, 10, 10, 0.36);
  }

  .address-link {
    display: block;
  }

  .directions-btn {
    margin-top: 12px;
  }

  .order-btn {
    margin-bottom: 8px;
  }

  .hours-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 6px;
  }

  .hours-line {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    max-width: 360px;
  }

  .hours-line span:first-child {
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .hours-note,
  .order-note {
    font-size: 0.78rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
  }

  .contact-card {
    padding: 30px;
  }

  .contact-row {
    display: flex;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .contact-row:last-of-type {
    border-bottom: none;
  }

  .contact-row svg {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--clay);
    margin-top: 2px;
  }

  .contact-row .label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 700;
    margin-bottom: 3px;
  }

  .contact-row .value {
    font-size: 0.98rem;
    font-weight: 600;
  }

  .contact-row a.value {
    text-decoration: none;
  }

  .contact-row a.value:hover {
    color: var(--clay);
  }

  .social-row {
    display: flex;
    gap: 13px;
    margin-top: 22px;
  }

  .social-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sand);
    transition: background 0.2s ease;
  }

  .social-btn.facebook {
    background: #1877f2;
  }

  .social-btn.facebook:hover {
    background: #0f5fc9;
  }

  .social-btn.instagram {
    background: #e1306c;
  }

  .social-btn.instagram:hover {
    background: #c22a5d;
  }

  .social-btn svg {
    width: 18px;
    height: 18px;
  }

  .storefront-photo {
    position: relative;
    overflow: hidden;
    min-height: 300px;
    padding: 0;
    border-color: rgba(43, 33, 24, 0.16);
    box-shadow: 0 10px 28px rgba(43, 33, 24, 0.14);
  }

  .storefront-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .section-sub {
    margin-top: 10px;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .class-form {
    max-width: 620px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-row.two-up {
    flex-direction: row;
    gap: 18px;
  }

  .form-row.two-up > div {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 11px 13px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
  }

  input:focus,
  textarea:focus {
    outline: 2.5px solid var(--clay);
    outline-offset: 1px;
    border-color: var(--clay);
  }

  textarea {
    resize: vertical;
  }

  .class-form .btn {
    align-self: flex-start;
  }

  .form-note {
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  @media (max-width: 980px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .form-row.two-up {
      flex-direction: column;
    }
  }
</style>

<script define:vars={{ INQUIRY_EMAIL }}>
  const form = document.getElementById('classForm');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);

    const name = (data.get('name') || '').toString().trim();
    const email = (data.get('email') || '').toString().trim();
    const phone = (data.get('phone') || '').toString().trim();
    const date = (data.get('date') || '').toString().trim();
    const partySize = (data.get('partySize') || '').toString().trim();
    const message = (data.get('message') || '').toString().trim();

    if (!name || !email) {
      form.reportValidity();
      return;
    }

    const bodyLines = [
      `Name: ${name}`,
      `Email: ${email}`,
      phone && `Phone: ${phone}`,
      date && `Preferred date: ${date}`,
      partySize && `Party size: ${partySize}`,
      '',
      'Details:',
      message || '(none provided)',
    ].filter(Boolean);

    const subject = encodeURIComponent(`Cooking Class Inquiry — ${name}`);
    const body = encodeURIComponent(bodyLines.join('\n'));

    window.location.href = `mailto:${INQUIRY_EMAIL}?subject=${subject}&body=${body}`;
  });
</script>
